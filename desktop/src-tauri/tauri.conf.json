{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dialga",
  "version": "0.6.3",
  "identifier": "com.decisyon.dialga",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm -C ../web dev",
    "beforeBuildCommand": "pnpm -C ../web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dialga",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "publisher": "Decisyon",
    "homepage": "https://bitbucket.org/decisyon/dialga",
    "category": "DeveloperTool",
    "shortDescription": "Import and export SQL Server databases on Amazon RDS via S3",
    "longDescription": "Dialga imports and exports SQL Server databases on Amazon RDS through S3, with native backup and restore, multi-database jobs and pre-flight checks. It ships a desktop app and the dialga command line tool.",
    "icon": [
      "icons/128x128.png",
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/dialga"],
    "linux": {
      "deb": {
        "section": "database",
        "desktopTemplate": "linux/desktop-entry.hbs",
        "files": {
          "/usr/share/doc/dialga/CHANGELOG.md": "../../CHANGELOG.md",
          "/usr/share/doc/dialga/config.example.yaml": "../../docs/config.example.yaml",
          "/usr/share/doc/dialga/iam-policy.json": "../../docs/iam-policy.json",
          "/usr/share/doc/dialga/guida-utente.md": "../../docs/guida-utente.md",
          "/usr/share/icons/hicolor/16x16/apps/dialga.png": "icons/16x16.png",
          "/usr/share/icons/hicolor/24x24/apps/dialga.png": "icons/24x24.png",
          "/usr/share/icons/hicolor/32x32/apps/dialga.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/48x48/apps/dialga.png": "icons/48x48.png",
          "/usr/share/icons/hicolor/64x64/apps/dialga.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/dialga.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/dialga.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/512x512/apps/dialga.png": "icons/icon.png"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/desktop-entry.hbs",
        "files": {
          "/usr/share/doc/dialga/CHANGELOG.md": "../../CHANGELOG.md",
          "/usr/share/doc/dialga/config.example.yaml": "../../docs/config.example.yaml",
          "/usr/share/doc/dialga/iam-policy.json": "../../docs/iam-policy.json",
          "/usr/share/doc/dialga/guida-utente.md": "../../docs/guida-utente.md",
          "/usr/share/icons/hicolor/16x16/apps/dialga.png": "icons/16x16.png",
          "/usr/share/icons/hicolor/24x24/apps/dialga.png": "icons/24x24.png",
          "/usr/share/icons/hicolor/32x32/apps/dialga.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/48x48/apps/dialga.png": "icons/48x48.png",
          "/usr/share/icons/hicolor/64x64/apps/dialga.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/dialga.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/dialga.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/512x512/apps/dialga.png": "icons/icon.png"
        }
      }
    }
  }
}
